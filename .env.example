# Copy this file to .env.local for local work, and set the same names on your host for the live site.
# Never commit real keys.

# --- Contact form email (Resend) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Webtics Digital <hello@webtics.digital>"

# --- Contact form bot protection (Cloudflare Turnstile) ---
# Create a widget in the Cloudflare dashboard (Turnstile) for webtics.digital, mode "Managed".
# The site key is public; the secret key must stay private.
# For local testing, Cloudflare publishes dummy keys that always pass:
#   site key   1x00000000000000000000AA
#   secret key 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
